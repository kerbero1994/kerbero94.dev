{
  "name": "kerbero94.dev",
  "private": true,
  "scripts": {
    "serve": "http-server site -p 8791 -a 127.0.0.1 -c-1 --silent",
    "test": "npm run test:static",
    "test:static": "bash checks/run-static.sh",
    "test:a11y": "node checks/scan.cjs http://127.0.0.1:8791 checks/result.json",
    "test:e2e": "playwright test --project=chrome --project=firefox --project=webkit-iphone",
    "test:visual": "playwright test --project=visual",
    "test:perf": "lhci autorun",
    "prepare": "git config core.hooksPath .githooks || true",
    "csp": "node scripts/csp.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "axe-core": "4.14.1",
    "cspell": "10.5.2",
    "html-validate": "11.21.1",
    "http-server": "14.1.1",
    "linkedom": "0.18.15",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.65.1"
  },
  "engines": {
    "node": ">=22"
  }
}
